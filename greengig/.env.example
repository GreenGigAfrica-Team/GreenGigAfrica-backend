# ── Django core ──────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgres://greengig:password@localhost:5432/greengig_db

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# ── Twilio (OTP SMS) ──────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ── AWS S3 (media / proof-of-work photos) ────────────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=greengig-media
AWS_S3_REGION_NAME=eu-west-1

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=hello@greengigatrica.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=GreenGig Africa <hello@greengigafrica.com>

# ── Frontend origin (CORS) ────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
